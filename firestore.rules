rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBAL HELPERS (PHASE 3)
    // -------------------------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // RBAC: Roles are fetched from the trusted users collection
    function getUserData(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function isAdmin() { 
      return isSignedIn() && 
             (request.auth.token.email == 'admin@tdtu.uz' || 
              (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && getUserData(request.auth.uid).role == 'admin')); 
    }
    function isLibrarian() { 
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData(request.auth.uid).role == 'librarian'; 
    }
    function isTutor() { 
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData(request.auth.uid).role == 'tutor'; 
    }
    function isStudent() { 
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             getUserData(request.auth.uid).role == 'student'; 
    }

    // -------------------------------------------------------------------------
    // GLOBAL SAFETY NET
    // -------------------------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // USERS COLLECTION
    // -------------------------------------------------------------------------
    // USERS COLLECTION
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'fullName', 'isActive', 'createdAt', 'updatedAt']) &&
             data.uid is string &&
             data.email is string &&
             data.role in ['student', 'librarian', 'tutor', 'admin'] &&
             data.fullName is string &&
             data.isActive is bool;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin() || isLibrarian());
      allow list: if isAdmin() || isLibrarian() || isTutor();
      
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
      allow update: if isAdmin() || (request.auth.uid == userId && isSignedIn());
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // BOOKS COLLECTION
    // -------------------------------------------------------------------------
    function isValidBook(data) {
      return data.keys().hasAll(['title', 'isbn', 'isPublished']) &&
             data.title is string && data.title.size() <= 512 &&
             data.isbn is string && data.isbn.size() <= 20;
    }

    match /books/{bookId} {
      allow get: if isValidId(bookId) && (existing().isPublished == true || isAdmin() || isLibrarian());
      allow list: if true;
      
      allow create: if (isAdmin() || isLibrarian()) && isValidBook(incoming());
      allow update: if (isAdmin() || isLibrarian()) && isValidBook(incoming());
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // BOOK COPIES COLLECTION
    // -------------------------------------------------------------------------
    match /bookCopies/{copyId} {
      allow read: if true;
      allow create, update: if (isAdmin() || isLibrarian()) && isValidId(incoming().bookId);
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // LOANS COLLECTION
    // -------------------------------------------------------------------------
    match /loans/{loanId} {
      allow get: if isSignedIn() && (request.auth.uid == resource.data.studentId || isAdmin() || isLibrarian());
      allow list: if isAdmin() || isLibrarian() || (isStudent() && resource.data.studentId == request.auth.uid);
      
      allow create: if (isAdmin() || isLibrarian()) && 
                      exists(/databases/$(database)/documents/users/$(incoming().studentId)) &&
                      exists(/databases/$(database)/documents/bookCopies/$(incoming().copyId));
                      
      allow update: if (isAdmin() || isLibrarian()) && 
                      incoming().studentId == existing().studentId &&
                      incoming().copyId == existing().copyId;
    }

    // -------------------------------------------------------------------------
    // RESERVATIONS COLLECTION
    // -------------------------------------------------------------------------
    match /reservations/{reservationId} {
      allow get: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin() || isLibrarian());
      allow list: if isAdmin() || isLibrarian() || (isStudent() && resource.data.userId == request.auth.uid);
      
      allow create: if isVerified() && 
                      incoming().userId == request.auth.uid &&
                      exists(/databases/$(database)/documents/books/$(incoming().bookId));
      
      allow update: if (isAdmin() || isLibrarian() || (request.auth.uid == existing().userId && isVerified())) &&
                      incoming().userId == existing().userId &&
                      (isAdmin() || isLibrarian() || incoming().diff(existing()).affectedKeys().hasOnly(['status']));
    }

    // -------------------------------------------------------------------------
    // NOTIFICATIONS COLLECTION
    // -------------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow get: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin() || isLibrarian());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isLibrarian());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
    }

    // -------------------------------------------------------------------------
    // FAVORITES COLLECTION
    // -------------------------------------------------------------------------
    match /favorites/{favoriteId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // READING PROGRESS & SESSIONS
    // -------------------------------------------------------------------------
    match /readingProgress/{progressId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isTutor());
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
    }

    match /readingSessions/{sessionId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin() || isTutor());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
    }

    // -------------------------------------------------------------------------
    // CATEGORIES COLLECTION
    // -------------------------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update: if isAdmin() || isLibrarian();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // SETTINGS & STATS COLLECTION
    // -------------------------------------------------------------------------
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
